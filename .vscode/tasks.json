{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build.bat",
            "type": "shell",
            "command": "scripts\\build.bat",
            "presentation": {"echo": false, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true},
        },
        {
            "label": "count_keywords.py",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["scripts\\count_keywords.py"]
        },
        {
            "label": "md2nexus.bat",
            "type": "shell",
            "command": "scripts\\md2nexus.bat",
            "presentation": {"echo": false, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true},
        },
        {
            "label": "mo2-downloads.bat",
            "type": "shell",
            "command": "scripts\\mo2-downloads.bat",
            "presentation": {"echo": false, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true},
        },
        {
            "label": "mo2-mod.bat",
            "type": "shell",
            "command": "scripts\\mo2-mod.bat",
            "presentation": {"echo": false, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true},
        },
        {
            "label": "spriggit-deserialize.bat",
            "type": "shell",
            "command": "scripts\\spriggit-deserialize.bat",
            "presentation": {"echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true},
        },
        {
            "label": "spriggit-serialize.bat",
            "type": "shell",
            "command": "scripts\\spriggit-serialize.bat",
            "presentation": {"echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true},
        },
        {
            "label": "Build",
            "group": "build",
            "dependsOn": [
                "build.bat"
            ]
        },
        {
            "label": "Build: Copy to MO2 Downloads",
            "group": "build",
            "dependsOn": [
                "build.bat",
                "mo2-downloads.bat"
            ]
        },
        {
            "label": "Build: Copy to MO2 Mod",
            "group": "build",
            "dependsOn": [
                "build.bat",
                "mo2-mod.bat"
            ]
        },
        {
            "label": "MD2Nexus: Compile Description",
            "group": "build",
            "dependsOn": [
                "md2nexus.bat"
            ]
        },
        {
            "label": "Spriggit: Serialize to YAML",
            "group": "build",
            "dependsOn": [
                "spriggit-serialize.bat"
            ]
        },
        {
            "label": "Spriggit: Deserialize to ESP",
            "group": "build",
            "dependsOn": [
                "spriggit-deserialize.bat"
            ]
        }
    ]
}
